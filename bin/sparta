#!/usr/bin/env node
import { spawn } from "node:child_process"
import { resolve, dirname } from "node:path"
import { fileURLToPath } from "node:url"

const __dirname = dirname(fileURLToPath(import.meta.url))
const root = resolve(__dirname, "..")
const webLauncher = resolve(root, "bin", "sparta-web")

// Launch web UI (no CLI)
const proc = spawn(process.execPath, [webLauncher, ...process.argv.slice(2)], {
  stdio: "ignore",
  windowsHide: true,
  detached: true,
})
proc.unref()
