#!/usr/bin/env node
import { spawn } from "node:child_process"
import { resolve, dirname } from "node:path"
import { fileURLToPath } from "node:url"
import { createRequire } from "node:module"

const __dirname = dirname(fileURLToPath(import.meta.url))
const spartaRoot = resolve(__dirname, "..")
const configDir = resolve(spartaRoot, ".opencode")
const env = { ...process.env, OPENCODE_CONFIG_DIR: configDir }

const require = createRequire(import.meta.url)
const engineNames = ["sparta", "opencode-ai"]
let engineBin

for (const name of engineNames) {
  try {
    const pkg = require.resolve(`${name}/package.json`)
    engineBin = resolve(dirname(pkg), "bin", "sparta.exe")
    if (engineBin) break
    engineBin = resolve(dirname(pkg), "bin", "opencode.exe")
    if (engineBin) break
  } catch {}
}

if (!engineBin) {
  console.error("S.P.A.R.T.A engine not found.")
  console.error("Reinstall: npm install -g github:Kenzioda/sparta-ai")
  process.exit(1)
}

const proc = spawn(engineBin, process.argv.slice(2), { stdio: "inherit", env })
proc.on("exit", (c) => process.exit(c ?? 1))
proc.on("error", (err) => {
  console.error("Failed to launch S.P.A.R.T.A:", err.message)
  process.exit(1)
})
